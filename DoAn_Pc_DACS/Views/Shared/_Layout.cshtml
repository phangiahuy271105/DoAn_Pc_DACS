@using Microsoft.AspNetCore.Http
@using DoAn_Pc_DACS.Helpers
@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PGHSHOP </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top bar kiểu viên thuốc -->
    <div class="top-bar d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <a href="#showrooms" class="pill-btn text-white"><i class="fas fa-map-marker-alt"></i> Hệ thống showroom</a>
                <a href="tel:0986552233" class="pill-btn text-white"><i class="fas fa-phone-alt"></i> Liên hệ cửa hàng</a>
            </div>
            <div>
                <!-- Nút của Khách Hàng (Hiện tại để #, sau này ông làm form Login khách hàng thì gắn link vào) -->

                <!-- DÒNG LỆNH BÍ MẬT: Chỉ khi nào ông gõ link ẩn đăng nhập thành công, nó mới hiện nút này lên -->
                @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <span class="text-white opacity-50 mx-2">|</span>
                    <a href="/Admin/Index" class="text-warning fw-bold me-2 text-decoration-none">
                        <i class="fa-solid fa-user-shield"></i> Trang Quản Trị
                    </a>
                    <span class="text-white opacity-50">|</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-link text-warning ms-2 p-0 text-decoration-none border-0">Đăng xuất</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="container py-2 text-end">
        <a asp-controller="Order" asp-action="Track" class="text-decoration-none fw-bold text-dark"><i class="fa-solid fa-truck-fast me-1"></i> Tra cứu đơn hàng</a>
    </div>
    <!-- Header -->
    <header class="header-main">
        <div class="container d-flex align-items-center justify-content-between">
            <a href="/" class="text-decoration-none" style="width: 250px;">
                
                <img src="~/images/banner/logoSTORE.png"
                     alt="Logo"
                     style="height: 75px;">
            </a>

            <!-- Search -->
            <form id="mySearchForm" action="/Product/Index" method="get" class="search-box flex-grow-1 me-4" style="position: relative;">

                <select id="searchSlug" name="slug">
                    <option value="">Tất cả danh mục</option>
                    <option value="pc-gaming">PC GAMING</option>
                    <option value="pc-workstation">PC WORKSTATION 2D 3D</option>
                    <option value="gear">GEAR GAMING</option>
                    <option value="linh-kien">Linh kiện máy tính</option>
                    <option value="man-hinh">Màn hình máy tính</option>
                </select>

                <!-- Đổi lại id="searchInput" để Javascript AJAX bên dưới nhận diện được -->
                <input type="text" id="searchInput" name="keyword" placeholder="Tìm kiếm sản phẩm..." autocomplete="off">

                <button type="submit" id="btnForceSearch">
                    <i class="fas fa-search"></i>
                </button>

                <div id="searchDropdown" class="search-suggest-dropdown" style="display: none;">
                    <ul id="suggestList" class="list-unstyled mb-0" style="margin:0; padding:0;">
                        <!-- Sản phẩm sẽ được JavaScript nhét vào đây -->
                    </ul>

                    <!-- Sửa lại chỗ này: Bấm vào thì bắt nó click cái nút Kính lúp -->
                    <button type="submit" class="suggest-footer text-center p-2">
                        Xem tất cả <strong id="suggestTotal">0</strong> kết quả tìm được
                    </button>
                </div>
            </form>

            <!-- Actions Hộp Xám -->
            <div class="header-actions">
                <a href="tel:0986552233" class="action-item">
                    <div class="icon-circle"><i class="fas fa-phone-alt"></i></div>
                    <div class="text-dark">
                        <span class="d-block" style="font-size: 11px;">Hotline mua hàng</span>
                        <span class="d-block fw-bold" style="font-size: 14px;">098.655.2233</span>
                    </div>
                </a>
                <a asp-controller="PcBuilder" asp-action="Index" class="action-item">
                    <div class="icon-circle"><i class="fas fa-desktop"></i></div>
                    <div class="text-dark fw-bold" style="font-size:12px;line-height:1.4;">Xây dựng<br />Cấu hình PC</div>
                </a>
                <a href="/Cart/Index" class="action-item position-relative">
                    <div class="icon-circle"><i class="fas fa-shopping-cart text-danger"></i></div>
                    <div class="text-dark fw-bold" style="font-size: 13px;">Giỏ hàng</div>
                    @{
                        var cart = HttpContextAccessor.HttpContext?.Session.Get<List<DoAn_Pc_DACS.Models.CartItem>>("Cart");
                        int cartCount = cart != null ? cart.Sum(c => c.Quantity) : 0;
                    }
                    @if (cartCount > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 10px; margin-left: -15px;">
                            @cartCount
                        </span>
                    }
                </a>
            </div>
        </div>
    </header>

    <!-- Menu Nền Trắng -->
    <div class="menu-wrapper">
        <div class="container d-flex align-items-center py-2">
            <div class="cat-btn mb-0" tabindex="0">
                <i class="fas fa-bars"></i> DANH MỤC SẢN PHẨM
                <div class="cat-menu-dropdown">
                    <a class="cat-item" href="/Product/Index?slug=pc-gaming">PC Gaming</a>
                    <a class="cat-item" href="/Product/Index?slug=pc-workstation">PC Workstation</a>
                    <a class="cat-item" href="/Product/Index?slug=linh-kien-may-tinh">Linh kiện máy tính</a>
                    <a class="cat-item" href="/Product/Index?slug=man-hinh">Màn hình máy tính</a>
                    <a class="cat-item" href="/Product/Index?slug=gear">Gaming Gear</a>
                    <a class="cat-item" href="/Product/Index?slug=ban-phim">Bàn phím</a>
                    <a class="cat-item" href="/Product/Index?slug=chuot">Chuột</a>
                    <a class="cat-item" href="/Product/Index?slug=tai-nghe">Tai nghe</a>
                </div>
            </div>

            <div class="main-menu flex-grow-1">
                <!-- Đổi href, giữ nguyên phần <div class="icon-bg">...</div> -->
                <a href="/Product/Index?slug=pc-gaming">
                    <div class="icon-bg"><i class="fa-duotone fa-solid fa-computer"></i></div> PC GAMING
                </a>

                <a href="/Product/Index?slug=pc-workstation">
                    <div class="icon-bg"><i class="fas fa-server"></i></div> PC WORKSTATION 2D 3D
                </a>

                <a href="/Product/Index?slug=linh-kien">
                    <div class="icon-bg"><i class="fas fa-microchip"></i></div> Linh kiện Máy Tính
                </a>

                <a href="/Product/Index?slug=man-hinh">
                    <div class="icon-bg"><i class="fa-vellum fa-solid fa-desktop"></i></div> Màn Hình
                </a>

                <a href="/Product/Index?slug=gear">
                    <div class="icon-bg"><i class="fa-solid fa-keyboard"></i></div> GEAR
                </a>
            </div>
        </div>
    </div>

    
    <!-- Ruột trang web (Các trang con sẽ chui vào đây) -->
    <main role="main">
        @RenderBody()
    </main>
    <section class="features">
        <div class="features__wrap">
            <div class="feature"><i class="fa-solid fa-truck-fast"></i><div><h4>GIAO HÀNG TOÀN QUỐC</h4><p>Giao hàng trước, trả tiền sau COD</p></div></div>
            <div class="feature"><i class="fa-solid fa-rotate-left"></i><div><h4>ĐỔI TRẢ DỄ DÀNG</h4><p>Đổi mới trong 30 ngày đầu</p></div></div>
            <div class="feature"><i class="fa-solid fa-wallet"></i><div><h4>THANH TOÁN KHI NHẬN HÀNG</h4><p>Kiểm tra thông tin đơn trước khi đặt</p></div></div>
            <div class="feature"><i class="fa-solid fa-headset"></i><div><h4>HỖ TRỢ NHIỆT TÌNH</h4><p>Tư vấn tổng đài miễn phí 24/7</p></div></div>
        </div>
    </section>

    <section class="commit">
        <p class="commit__sub">Trải nghiệm mua sắm tại <strong>TTG SHOP</strong></p>
        <h2 class="commit__title">Cam Kết <span>100%</span> Hài Lòng</h2>
        <div class="commit__list">
            <div class="commit__item"><span>1. Liên hệ chăm sóc khách hàng dễ dàng</span><i class="fa-solid fa-plus"></i></div>
            <div class="commit__item"><span>2. Giao hàng nhanh trong 2 giờ mà không thu thêm phí</span><i class="fa-solid fa-plus"></i></div>
            <div class="commit__item"><span>3. Miễn phí lên đời và trải nghiệm sản phẩm trong vòng 15 ngày</span><i class="fa-solid fa-plus"></i></div>
            <div class="commit__item"><span>4. Cam kết thu cũ đổi mới trọn đời với tất cả các sản phẩm Gaming Gear và linh kiện máy tính</span><i class="fa-solid fa-plus"></i></div>
            <div class="commit__item"><span>5. Cho mượn sản phẩm miễn phí thay thế trong thời gian bảo hành tại TTG SHOP</span><i class="fa-solid fa-plus"></i></div>
        </div>
    </section>
    <!-- Showrooms Footer -->
    <div class="showrooms" id="showrooms">
        <div class="container">
            <h2>HỆ THỐNG SHOWROOM PGH</h2>
            <div class="grid2">
                <div class="box">
                    <div class="bar">SHOWROOM HÀ NỘI</div>
                    <p>📍 Địa chỉ: 85 Thái Hà - Đống Đa - HN</p>
                    <p>📞 098.655.2233</p>
                    <p>✉️ pghshoponline@gmail.com</p>
                </div>
                <div class="box">
                    <div class="bar">SHOWROOM TP. HỒ CHÍ MINH</div>
                    <p>📍 Địa chỉ: 83A Cửu Long - Q10 - TPHCM</p>
                    <p>📞 098.655.2233</p>
                    <p>✉️ pghshoponline@gmail.com</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer Bottom -->
    <footer class="bottom">
        <div class="container grid4">
            <div>
                <h4>Về PGH SHOP</h4>
                <p style="line-height:1.6;">PGH SHOP là đơn vị chuyên cung cấp PC Gaming, PC Workstation, linh kiện máy tính giá tốt.</p>
            </div>
            <div>
                <h4>Thông tin liên hệ</h4>
                <ul>
                    <li>CS1: 85 Thái Hà - Đống Đa - HN</li>
                    <li>CS2: 83A Cửu Long - Q10 - TPHCM</li>
                    <li>098.655.2233</li>
                </ul>
            </div>
            <div>
                <h4>Tài khoản ngân hàng</h4>
                <ul><li>Tra cứu phương thức thanh toán</li></ul>
            </div>
            <div>
                <h4>Chính sách</h4>
                <ul>
                    <li>Chính sách bảo mật</li>
                    <li>Quy định bảo hành</li>
                    <li>Chính sách đổi trả</li>
                    <li>Điều khoản sử dụng</li>
                </ul>
            </div>
        </div>
        <div class="copyright container">© 2026 PGHSHOP - Đồ án lập trình.</div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
