@model List<DoAn_Pc_DACS.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng của bạn";

    bool hasStockError = Model != null &&
        Model.Any(x =>
            x.StockQuantity <= 0 ||
            x.Quantity > x.StockQuantity
        );
}

<div class="container mt-5 mb-5" style="max-width: 1200px;">
    <h2 class="fw-bold mb-4" style="color: #ff5636;"><i class="fa-solid fa-cart-shopping"></i> GIỎ HÀNG CỦA BẠN</h2>
    @if (TempData["CartError"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            @TempData["CartError"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-light text-center py-5 border">
            <h4 class="fw-bold text-muted">Giỏ hàng đang trống!</h4>
            <p>Chưa có sản phẩm nào trong giỏ hàng của bạn.</p>
            <a href="/" class="btn text-white mt-3 fw-bold" style="background: #ff5636;">TIẾP TỤC MUA SẮM</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-0 table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Sản phẩm</th>
                                    <th class="text-center" style="width: 130px;">Đơn giá</th>
                                    <th class="text-center" style="width: 130px;">Số lượng</th>
                                    <th class="text-center" style="width: 130px;">Thành tiền</th>
                                    <th class="text-center" style="width: 60px;">Xóa</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@item.ImageUrl" style="width: 70px; height: 70px; object-fit: contain; border: 1px solid #eee; border-radius: 6px; padding: 4px;" />
                                                <a href="/Home/Details/@item.ProductId" class="text-dark fw-bold text-decoration-none" style="font-size: 14px;">@item.ProductName</a>
                                            </div>
                                        </td>
                                        <td class="text-center text-danger fw-bold">@item.Price.ToString("N0")đ</td>
                                        <td class="text-center">
                                            <!-- Form cập nhật số lượng tự động khi đổi số -->
                                            <form asp-action="UpdateQuantity" asp-controller="Cart" method="post" class="d-flex justify-content-center">
                                                <input type="hidden" name="id" value="@item.ProductId" />
                                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.StockQuantity" class="form-control text-center fw-bold" style="width: 60px;" onchange="this.form.submit()" />
                                            </form>
                                            @if (item.StockQuantity > 0)
                                            {
                                                <div class="text-muted mt-1" style="font-size: 11px;">
                                                    Kho: @item.StockQuantity
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-danger fw-bold mt-1" style="font-size: 11px;">
                                                    Hết hàng
                                                </div>
                                            }
                                        </td>
                                        <td class="text-center text-danger fw-bold">@item.TotalPrice.ToString("N0")đ</td>
                                        <td class="text-center">
                                            <form asp-action="RemoveFromCart" asp-controller="Cart" method="post">
                                                <input type="hidden" name="id" value="@item.ProductId" />
                                                <button type="submit" class="btn btn-link text-danger fs-5 p-0" title="Xóa sản phẩm"
                                                        onclick="return confirm('Xóa sản phẩm này khỏi giỏ hàng?');">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mt-4 mt-md-0">
                <div class="card shadow-sm border-0 p-4" style="background: #f8f9fa;">
                    <h5 class="fw-bold border-bottom pb-3 mb-3">TÓM TẮT ĐƠN HÀNG</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="fw-bold">Tạm tính:</span>
                        <span>@Model.Sum(x => x.TotalPrice).ToString("N0") VNĐ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 text-success fw-bold">
                        <span>Phí vận chuyển:</span>
                        <span>Miễn phí</span>
                    </div>
                    <div class="d-flex justify-content-between border-top pt-3 mb-4">
                        <span class="fw-bold fs-5">TỔNG TIỀN:</span>
                        <span class="text-danger fw-bold fs-4">@Model.Sum(x => x.TotalPrice).ToString("N0") VNĐ</span>
                    </div>
                    @if (!hasStockError)
                    {
                        <a href="/Cart/Checkout"
                           class="btn btn-lg w-100 fw-bold mb-2 text-white d-block text-center text-decoration-none"
                           style="background: #ff5636;">
                            TIẾN HÀNH THANH TOÁN
                        </a>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-secondary btn-lg w-100 fw-bold mb-2"
                                disabled>
                            KIỂM TRA LẠI TỒN KHO
                        </button>

                        <small class="text-danger d-block text-center mb-2">
                            Có sản phẩm không đủ số lượng để thanh toán.
                        </small>
                    }
                    <a href="/" class="btn btn-outline-secondary w-100 fw-bold">TIẾP TỤC MUA HÀNG</a>
                </div>
            </div>
        </div>
    }
</div>
