@model DoAn_Pc_DACS.Models.Product
@{
    ViewData["Title"] = Model.Name;
    bool isPcProduct = Model.Category?.Slug is "pc-gaming" or "pc-workstation" or "pc-workstation-2d-3d";
    string[] descriptionLines = (Model.Description ?? string.Empty)
        .Split(["\r\n", "\n"], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    string[] accessorySpecLines = (Model.TechnicalSpecifications ?? string.Empty)
        .Split(["\r\n", "\n"], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="~/css/details.css" />

<div class="container mt-3" style="max-width: 1450px;">
    <!-- CÂY THƯ MỤC BREADCRUMB -->
    <div class="breadcrumb-dt mb-4 fw-bold" style="font-size: 13px;">
        <a href="/" class="text-decoration-none text-secondary">Trang chủ</a> <span class="mx-2 text-muted">›</span>
        <a asp-controller="Product" asp-action="Index" asp-route-slug="@Model.Category?.Slug" class="text-decoration-none text-secondary">@(Model.Category != null ? Model.Category.Name : "Sản phẩm")</a> <span class="mx-2 text-muted">›</span>
        <span class="text-dark">@Model.Name</span>
    </div>

    <!-- HỆ THỐNG CHIA 2 CỘT CỨNG CÁP -->
    <div class="row">

        <!-- ================= CỘT TRÁI ================= -->
        <div class="col-lg-5 col-md-12 mb-4">
            <style>
                .custom-scrollbar::-webkit-scrollbar { height: 6px; }
                .custom-scrollbar::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 4px; }
                .custom-scrollbar::-webkit-scrollbar-thumb { background: #ccc; border-radius: 4px; }
                .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #888; }
                .active-thumb { border: 2px solid #0d6efd !important; opacity: 1 !important; }
                .thumbnail-img { opacity: 0.6; transition: 0.2s; cursor: pointer; }
                .thumbnail-img:hover { opacity: 1; }
            </style>

            <!-- HÌNH ẢNH SẢN PHẨM -->
            <div class="product-images mb-4">
                <div class="main-image-wrapper position-relative bg-white border rounded text-center d-flex align-items-center justify-content-center shadow-sm" style="height: 420px; cursor: zoom-in;" onclick="openLightbox()">
                    <button class="btn btn-dark position-absolute top-50 start-0 translate-middle-y ms-2 opacity-50 rounded-circle" style="width: 40px; height: 40px; z-index: 10;" onclick="prevImage(event)">&#10094;</button>
                    <img id="mainImage" src="@Model.ImageUrl" class="img-fluid" style="max-height: 100%; object-fit: contain; transition: 0.3s; padding: 10px;" />
                    <button class="btn btn-dark position-absolute top-50 end-0 translate-middle-y me-2 opacity-50 rounded-circle" style="width: 40px; height: 40px; z-index: 10;" onclick="nextImage(event)">&#10095;</button>
                </div>

                @if (Model.ProductImages != null && Model.ProductImages.Count > 0)
                {
                    <div id="thumbnailContainer" class="d-flex gap-2 py-3 mt-2 overflow-auto custom-scrollbar" style="white-space: nowrap; cursor: grab;">
                        <img src="@Model.ImageUrl" class="thumbnail-img rounded border shadow-sm active-thumb" style="width: 85px; height: 85px; object-fit: contain; flex-shrink: 0;" onclick="changeImage(this, '@Model.ImageUrl', 0)" />
                        @{ int imgIndex = 1; }
                        @foreach (var img in Model.ProductImages)
                        {
                            <img src="@img.ImageUrl" class="thumbnail-img rounded border shadow-sm" style="width: 85px; height: 85px; object-fit: contain; flex-shrink: 0;" onclick="changeImage(this, '@img.ImageUrl', @imgIndex)" />
                            imgIndex++;
                        }
                    </div>
                }
            </div>
            @{
                var bundleProducts = ViewBag.BundleProducts as IEnumerable<BundleProductViewModel> ?? Enumerable.Empty<BundleProductViewModel>();
                var bundleProductList = bundleProducts.ToList();
            }
            @if (bundleProductList.Count > 0)
            {
                <div class="combo-tag-img">Sản phẩm mua kèm</div>
                <form asp-controller="Cart" asp-action="AddBundleToCart" method="post" id="bundleForm">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="combo-wrapper">
                        <button type="button" class="combo-arrow prev" id="btnComboPrev"><i class="fa-solid fa-chevron-left"></i></button>
                        <div class="combo-items custom-scrollbar" id="comboSlider">
                            @foreach (var bundleProduct in bundleProductList)
                            {
                                decimal saving = Math.Max(0, bundleProduct.OldPrice - bundleProduct.Price);
                                bool available = bundleProduct.StockQuantity > 0;
                                <div class="combo-item-img bundle-product-card @(available ? "bundle-selected" : "bundle-unavailable")"
                                     data-relation-id="@bundleProduct.RelationId"
                                     data-product-id="@bundleProduct.ProductId"
                                     data-category-name="@bundleProduct.CategoryName"
                                     data-price="@bundleProduct.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                     data-discount="@saving.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    <input type="hidden" name="relationIds" value="@bundleProduct.RelationId"
                                           class="bundle-form-input bundle-relation-input" disabled="@(!available)" />
                                    <input type="hidden" name="relatedProductIds" value="@bundleProduct.ProductId"
                                           class="bundle-form-input bundle-product-input" disabled="@(!available)" />
                                    <i class="fa-solid fa-circle-check check-icon"></i>
                                    <div class="bundle-category">@bundleProduct.CategoryName</div>
                                    <img class="bundle-product-image" src="@bundleProduct.ImageUrl" alt="@bundleProduct.Name" loading="lazy" />
                                    <h4 class="bundle-product-name">@bundleProduct.Name</h4>
                                    <div class="bundle-old-price">@(bundleProduct.OldPrice > bundleProduct.Price ? $"{bundleProduct.OldPrice:N0}đ" : string.Empty)</div>
                                    <div class="sel-new-price bundle-product-price">@bundleProduct.Price.ToString("N0")đ</div>
                                    <div class="sel-save bundle-product-saving">@(available ? $"Tiết kiệm {saving:N0}đ" : "Hết hàng - hãy chọn sản phẩm khác")</div>
                                    <div class="bundle-actions">
                                        <button type="button" class="btn-remove-bundle" onclick="removeBundleProduct(this)">Xóa</button>
                                        <button type="button" class="btn-change-bundle" onclick="openBundleModal(this)">Sản phẩm khác</button>
                                    </div>
                                </div>
                            }
                        </div>
                        <button type="button" class="combo-arrow next" id="btnComboNext"><i class="fa-solid fa-chevron-right"></i></button>
                    </div>

                    <div class="combo-price-bar">
                        <div class="cp-left">
                            <div class="cp-tamtinh">Tạm tính: <span id="lblTamTinh" data-baseprice="@Model.Price" class="cp-tamtinh-val">@Model.Price.ToString("N0")đ</span></div>
                            <div class="cp-tietkiem">Tiết kiệm: <span id="lblTietKiem" data-basediscount="@Math.Max(0, Model.OldPrice - Model.Price)" class="cp-tietkiem-val">@Math.Max(0, Model.OldPrice - Model.Price).ToString("N0")đ</span></div>
                        </div>
                        <button type="submit" class="btn-buy-combo" disabled="@(Model.StockQuantity <= 0)">
                            <i class="fa-solid fa-cart-shopping"></i> Mua combo
                        </button>
                    </div>
                </form>

                <div class="combo-modal-overlay" id="bundleModal" aria-hidden="true">
                    <div class="combo-modal" role="dialog" aria-modal="true" aria-labelledby="bundleModalTitle">
                        <div class="combo-modal-header">
                            <div>
                                <h3 id="bundleModalTitle">Sản phẩm được đề xuất</h3>
                                <span id="bundleModalCategory" class="bundle-modal-category"></span>
                            </div>
                            <button type="button" class="btn-close-modal" onclick="closeBundleModal()" aria-label="Đóng">&times;</button>
                        </div>
                        <div class="bundle-modal-tools">
                            <input type="search" id="bundleSearchInput" placeholder="Bạn cần tìm sản phẩm gì?" autocomplete="off" />
                            <select id="bundleSortSelect" aria-label="Sắp xếp sản phẩm">
                                <option value="newest">Mới nhất</option>
                                <option value="price-asc">Giá tăng dần</option>
                                <option value="price-desc">Giá giảm dần</option>
                            </select>
                        </div>
                        <div class="combo-modal-body">
                            <div id="bundleModalLoading" class="bundle-modal-message">Đang tải sản phẩm...</div>
                            <div id="bundleModalEmpty" class="bundle-modal-message d-none">Danh mục này chưa có sản phẩm phù hợp.</div>
                            <div class="modal-grid" id="bundleModalGrid"></div>
                        </div>
                    </div>
                </div>
            }
        </div>


        <!-- ================= CỘT PHẢI (GIỮ NGUYÊN 100% NHƯ YÊU CẦU) ================= -->
        <div class="col-lg-7 col-md-12 info-panel bg-white p-4 rounded shadow-sm">
            <h1 class="fw-bold text-dark text-uppercase fs-3 mb-3">@Model.Name</h1>

            <div class="price-box mb-4">
                <div class="price-left">
                    <span class="current-price">@Model.Price.ToString("N0") <u>đ</u></span>
                    <span class="old-price">@Model.OldPrice.ToString("N0") đ</span>
                </div>
                <span class="save-price">Tiết kiệm: @((Model.OldPrice - Model.Price).ToString("N0"))Đ</span>
            </div>

            <div class="badges-row mb-4">
                <span class="badge-warranty"><i class="fa-solid fa-shield-halved me-1"></i> @(isPcProduct ? "Bảo hành: 36 Tháng" : "Bảo hành chính hãng")</span>
                <a href="tel:0986552233" class="badge-upgrade"><i class="fa-solid fa-headset"></i> TƯ VẤN SẢN PHẨM</a>
            </div>

            <div class="desc-block mb-4">
                <h3 class="border-bottom pb-2 mb-3"><i class="fa-solid fa-microchip text-primary"></i> Mô tả sản phẩm</h3>
                <ul class="lh-lg text-dark fw-medium">
                    @if (descriptionLines.Length > 0)
                    {
                        foreach (string line in descriptionLines)
                        {
                            <li><i class="fa-solid fa-circle-check text-success"></i> @line</li>
                        }
                    }
                    else if (isPcProduct && Model.ComponentSpec != null)
                    {
                        if (!string.IsNullOrEmpty(Model.ComponentSpec.Socket)) { <li><i class="fa-solid fa-circle-check text-success"></i> @Model.ComponentSpec.Socket</li> }
                        if (!string.IsNullOrEmpty(Model.ComponentSpec.Mainboard)) { <li><i class="fa-solid fa-circle-check text-success"></i> @Model.ComponentSpec.Mainboard</li> }
                        if (!string.IsNullOrEmpty(Model.ComponentSpec.RamType)) { <li><i class="fa-solid fa-circle-check text-success"></i> @Model.ComponentSpec.RamType</li> }
                        if (!string.IsNullOrEmpty(Model.ComponentSpec.Storage)) { <li><i class="fa-solid fa-circle-check text-success"></i> @Model.ComponentSpec.Storage</li> }
                        if (!string.IsNullOrEmpty(Model.ComponentSpec.PowerSupply)) { <li><i class="fa-solid fa-circle-check text-success"></i> @Model.ComponentSpec.PowerSupply</li> }
                        if (!string.IsNullOrEmpty(Model.ComponentSpec.Vga)) { <li><i class="fa-solid fa-circle-check text-success"></i> @Model.ComponentSpec.Vga</li> }
                        if (!string.IsNullOrEmpty(Model.ComponentSpec.FormFactor)) { <li><i class="fa-solid fa-circle-check text-success"></i> @Model.ComponentSpec.FormFactor</li> }
                        if (!string.IsNullOrEmpty(Model.ComponentSpec.Cooler)) { <li><i class="fa-solid fa-circle-check text-success"></i> @Model.ComponentSpec.Cooler</li> }
                    }
                    else if (!isPcProduct && accessorySpecLines.Length > 0)
                    {
                        foreach (string line in accessorySpecLines.Take(4))
                        {
                            <li><i class="fa-solid fa-circle-check text-success"></i> @line</li>
                        }
                    }
                    else
                    {
                        <li>Thông tin sản phẩm đang được cập nhật.</li>
                    }
                </ul>
            </div>

            <div class="promo-box mb-4">
                <div class="promo-title"><i class="fa-solid fa-gift"></i> KHUYẾN MÃI</div>
                @if (isPcProduct)
                {
                    <p><i class="fa-solid fa-flag"></i> Máy ráp sẵn đã bao gồm Windows 10/11 bản dùng thử trong 30 ngày.</p>
                    <p><i class="fa-solid fa-flag"></i> Sản phẩm được kiểm tra cấu hình trước khi giao hàng.</p>
                }
                else
                {
                    <p><i class="fa-solid fa-flag"></i> Sản phẩm chính hãng, được kiểm tra trước khi giao hàng.</p>
                    <p><i class="fa-solid fa-flag"></i> Hỗ trợ đổi trả và bảo hành theo chính sách của nhà sản xuất.</p>
                }
            </div>

            <!-- FORM ĐẶT HÀNG (LẤY 100% CẤU TRÚC VÀ CLASS CỦA ÔNG) -->
            @if (Model.StockQuantity > 0)
            {
                <form asp-controller="Cart"
                      asp-action="AddToCart"
                      method="post"
                      class="mt-4 border-top pt-4">

                    <input type="hidden" name="id" value="@Model.Id" />

                    @if (Model.StockQuantity <= 5)
                    {
                        <div class="alert alert-warning py-2 mb-3 fw-bold">
                            <i class="fa-solid fa-triangle-exclamation me-1"></i>
                            Chỉ còn @Model.StockQuantity sản phẩm trong kho
                        </div>
                    }
                    else
                    {
                        <div class="mb-3 text-success fw-bold">
                            <i class="fa-solid fa-circle-check me-1"></i>
                            Còn hàng
                        </div>
                    }

                    <div class="qty-row">
                        <span>Số lượng:</span>

                        <div class="qty-control">
                            <button type="button"
                                    onclick="decreaseQtyCustom()">
                                −
                            </button>

                            <input type="text"
                                   id="productQty"
                                   name="quantity"
                                   value="1"
                                   data-stock="@Model.StockQuantity"
                                   readonly />

                            <button type="button"
                                    onclick="increaseQtyCustom()">
                                +
                            </button>
                        </div>
                    </div>
                    <button type="submit" class="btn-order">ĐẶT HÀNG NGAY</button>
                    
                    <button type="submit" class="btn-order">
                        <i class="fa-solid fa-cart-shopping me-2"></i>
                        THÊM VÀO GIỎ
                    </button>

                </form>
            }
            else
            {
                <div class="mt-4 border-top pt-4">

                    <div class="alert alert-danger d-flex align-items-center gap-3 p-3 mb-3">
                        <i class="fa-solid fa-box-open"
                           style="font-size: 32px;"></i>

                        <div>
                            <div class="fw-bold fs-5">
                                SẢN PHẨM ĐÃ HẾT HÀNG
                            </div>

                            <div style="font-size: 13px;">
                                Sản phẩm này hiện không còn trong kho.
                                Vui lòng chọn sản phẩm khác.
                            </div>
                        </div>
                    </div>

                    <button type="button"
                            class="btn btn-secondary w-100 fw-bold py-3"
                            disabled>
                        <i class="fa-solid fa-ban me-2"></i>
                        TẠM HẾT HÀNG
                    </button>
                </div>
            }
        </div>
    </div>
</div>
<section class="section-dt">
    <div class="panel-dt">
        <h2>THÔNG SỐ KỸ THUẬT</h2>
        @if (isPcProduct)
        {
            <table class="specs-tb table table-bordered mt-3 align-middle text-center fw-bold">
            <thead class="table-light">
                <tr>
                    <th style="width: 80px;" class="text-center">STT</th>
                    <th class="text-center">Mô tả thiết bị</th>
                    <th style="width: 80px;" class="text-center">SL</th>
                    <th style="width: 100px;" class="text-center">BH</th>
                </tr>
            </thead>
            <tbody>
                @{ int stt = 1; }
                @if (Model.ComponentSpec != null)
                {
                    if (!string.IsNullOrEmpty(Model.ComponentSpec.Socket)) { <tr><td>@(stt++)</td><td class="text-center">@Model.ComponentSpec.Socket</td><td>@Model.ComponentSpec.SocketSl</td><td>@Model.ComponentSpec.SocketBh</td></tr> }
                    if (!string.IsNullOrEmpty(Model.ComponentSpec.Mainboard)) { <tr><td>@(stt++)</td><td class="text-center">@Model.ComponentSpec.Mainboard</td><td>@Model.ComponentSpec.MainboardSl</td><td>@Model.ComponentSpec.MainboardBh</td></tr> }
                    if (!string.IsNullOrEmpty(Model.ComponentSpec.RamType)) { <tr><td>@(stt++)</td><td class="text-center">@Model.ComponentSpec.RamType</td><td>@Model.ComponentSpec.RamSl</td><td>@Model.ComponentSpec.RamBh</td></tr> }
                    if (!string.IsNullOrEmpty(Model.ComponentSpec.Storage)) { <tr><td>@(stt++)</td><td class="text-center">@Model.ComponentSpec.Storage</td><td>@Model.ComponentSpec.StorageSl</td><td>@Model.ComponentSpec.StorageBh</td></tr> }
                    if (!string.IsNullOrEmpty(Model.ComponentSpec.PowerSupply)) { <tr><td>@(stt++)</td><td class="text-center">@Model.ComponentSpec.PowerSupply</td><td>@Model.ComponentSpec.PowerSupplySl</td><td>@Model.ComponentSpec.PowerSupplyBh</td></tr> }
                    if (!string.IsNullOrEmpty(Model.ComponentSpec.Vga)) { <tr><td>@(stt++)</td><td class="text-center">@Model.ComponentSpec.Vga</td><td>@Model.ComponentSpec.VgaSl</td><td>@Model.ComponentSpec.VgaBh</td></tr> }
                    if (!string.IsNullOrEmpty(Model.ComponentSpec.FormFactor)) { <tr><td>@(stt++)</td><td class="text-center">@Model.ComponentSpec.FormFactor</td><td>@Model.ComponentSpec.FormFactorSl</td><td>@Model.ComponentSpec.FormFactorBh</td></tr> }
                    if (!string.IsNullOrEmpty(Model.ComponentSpec.Cooler)) { <tr><td>@(stt++)</td><td class="text-center">@Model.ComponentSpec.Cooler</td><td>@Model.ComponentSpec.CoolerSl</td><td>@Model.ComponentSpec.CoolerBh</td></tr> }
                }
            </tbody>
            </table>
            <a class="see-more" id="btn-see-more">Xem thêm ⌄</a>
        }
        else if (accessorySpecLines.Length > 0)
        {
            <table class="specs-tb table table-bordered mt-3 align-middle">
                <thead class="table-light">
                    <tr><th style="width:35%;">Thông số</th><th>Chi tiết</th></tr>
                </thead>
                <tbody>
                    @foreach (string line in accessorySpecLines)
                    {
                        int separatorIndex = line.IndexOf(':');
                        if (separatorIndex > 0)
                        {
                            <tr>
                                <td class="fw-bold">@line[..separatorIndex].Trim()</td>
                                <td>@line[(separatorIndex + 1)..].Trim()</td>
                            </tr>
                        }
                        else
                        {
                            <tr><td colspan="2">@line</td></tr>
                        }
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-light border mt-3 mb-0">Thông số kỹ thuật đang được cập nhật.</div>
        }
    </div>
</section>

<!-- ================= SẢN PHẨM TƯƠNG TỰ ================= -->
<section class="section-dt" style="margin-bottom: 50px;">
    <div class="section-head-dt">
        <h2>SẢN PHẨM TƯƠNG TỰ</h2>
        <a class="see-all" asp-controller="Product" asp-action="Index" asp-route-slug="@Model.Category?.Slug">Xem tất cả »</a>
    </div>

    <div class="similar-wrapper">
        <button class="similar-arrow prev" id="sim-prev"><i class="fa-solid fa-chevron-left"></i></button>
        <div class="similar-slider" id="sim-slider">
            @{
                var similarProducts = ViewBag.SimilarProducts as IEnumerable<Product> ?? Enumerable.Empty<Product>();
            }
            @foreach (var item in similarProducts)
            {
                <div class="pcard-dt">
                    <a asp-controller="Home" asp-action="Details" asp-route-id="@item.Id" style="display: block; text-decoration: none; color: inherit; flex: 1;">
                        <div class="thumb">
                            <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" />
                        </div>
                        <h3>@item.Name</h3>
                        <div class="price-area">
                            <div class="price-col">
                                <span class="new-price">@item.Price.ToString("N0") VNĐ</span>
                                @if (item.OldPrice > item.Price)
                                {
                                    <span class="old-price-card">@item.OldPrice.ToString("N0") VNĐ</span>
                                }
                            </div>
                            @if (item.DiscountPercent > 0)
                            {
                                <span class="discount-badge">-@item.DiscountPercent%</span>
                            }
                        </div>
                    </a>
                    <div class="action-area">
                        @if (item.StockQuantity > 0)
                        {
                            <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn-add"><i class="fa-solid fa-cart-shopping"></i> THÊM VÀO GIỎ</button>
                            </form>
                            <span class="stock">Còn hàng</span>
                        }
                        else
                        {
                            <button type="button" class="btn-add" disabled>HẾT HÀNG</button>
                            <span class="stock" style="color:#dc3545;">Hết hàng</span>
                        }
                    </div>
                </div>
            }
        </div>
        <button class="similar-arrow next" id="sim-next"><i class="fa-solid fa-chevron-right"></i></button>
    </div>
</section>

<!-- ================= POPUP (Dành riêng cho JS) ================= -->
<div id="lightboxOverlay" class="position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-75 d-none justify-content-center align-items-center" style="z-index: 9999;" onclick="closeLightbox(event)">
    <button class="btn btn-light position-absolute top-0 end-0 m-4 rounded-circle fw-bold" onclick="closeLightbox(event)" style="width: 40px; height: 40px;">X</button>
    <img id="lightboxImage" src="" class="img-fluid rounded shadow-lg" style="max-height: 90vh; max-width: 90vw; object-fit: contain;" />
</div>
