@model IEnumerable<DoAn_Pc_DACS.Models.Product>
@{
    ViewData["Title"] = "Tất cả sản phẩm";
}

<div class="container mt-4 mb-5" style="max-width: 1450px;">
    <!-- Breadcrumb -->
    <div class="breadcrumb-dt mb-4 fw-bold" style="font-size: 13px;">
        <a href="/" class="text-decoration-none text-secondary">Trang chủ</a> <span class="mx-2 text-muted">›</span>
        <span class="text-dark">Tất cả sản phẩm</span>
    </div>

    <div class="row">
        <!-- ================= CỘT TRÁI: BỘ LỌC (SIDEBAR) ================= -->
        <div class="col-lg-3 col-md-4 mb-4">
            <form id="filterForm" method="get" action="/Product/Index">
                <input type="hidden" name="keyword" value="@ViewBag.CurrentKeyword" />
                <div class="bg-white p-3 rounded shadow-sm border">
                    <h5 class="fw-bold mb-3 border-bottom pb-2 text-uppercase">
                        <i class="fa-solid fa-filter text-danger"></i> LỌC SẢN PHẨM
                    </h5>
                    @foreach (var filter in new[] {
                        ("slug", "Danh mục", new[] { ("", "Tất cả sản phẩm"), ("pc-gaming", "PC Gaming"), ("pc-workstation", "PC Workstation"), ("linh-kien-may-tinh", "Linh kiện máy tính"), ("man-hinh", "Màn hình"), ("gear", "Gaming Gear"), ("ban-phim", "Bàn phím"), ("chuot", "Chuột"), ("tai-nghe", "Tai nghe") }),
                        ("priceRange", "Khoảng giá", new[] { ("", "Tất cả mức giá"), ("0-1000000", "Dưới 1 triệu"), ("1000000-3000000", "1 – 3 triệu"), ("3000000-5000000", "3 – 5 triệu"), ("5000000-10000000", "5 – 10 triệu"), ("10000000-20000000", "10 – 20 triệu"), ("20000000-30000000", "20 – 30 triệu"), ("30000000-999999999", "Trên 30 triệu") })
                    })
                    {
                        <fieldset class="mb-4">
                            <legend class="fs-6 fw-bold">@filter.Item2</legend>
                            @foreach (var option in filter.Item3)
                            {
                                string current = (filter.Item1 == "slug" ? ViewBag.CurrentSlug : ViewBag.CurrentPrice) ?? "";
                                <label class="d-flex align-items-center gap-2 mb-2">
                                    <input type="radio" name="@filter.Item1" value="@option.Item1" checked="@(current == option.Item1)" /> @option.Item2
                                </label>
                            }
                        </fieldset>
                    }
                    <fieldset class="mb-4" id="cpuFilters">
                        <legend class="fs-6 fw-bold">CPU (PC / linh kiện)</legend>
                        @foreach (var brand in new[] { "Intel", "AMD" })
                        {
                            <label class="d-flex align-items-center gap-2 mb-2">
                                <input type="checkbox" name="cpuBrand" value="@brand" checked="@((ViewBag.CurrentCpu as string[] ?? []).Contains(brand))" /> @brand
                            </label>
                        }
                    </fieldset>
                    <a href="/Product/Index" class="d-block mb-3">Xóa bộ lọc</a>

                    <button type="submit" class="btn btn-danger w-100 fw-bold shadow-sm py-2">XEM KẾT QUẢ LỌC</button>
                </div>
            </form>
        </div>

        <!-- ================= CỘT PHẢI: LƯỚI SẢN PHẨM ================= -->
        <div class="col-lg-9 col-md-8">
            <!-- Thanh Công Cụ (Sắp xếp) -->
            <div class="bg-white p-3 rounded shadow-sm border mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h4 class="fw-bold m-0 text-dark">
                    Tìm thấy <span class="text-danger">@(Model != null ? Model.Count() : 0)</span> sản phẩm
                </h4>
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold" style="font-size: 14px;">Sắp xếp theo:</span>
                    <select class="form-select form-select-sm border-danger text-danger fw-bold shadow-none" style="width: 150px;" onchange="this.form.submit()" form="filterForm" name="sortBy">
                        <option value="newest" selected="@(ViewBag.CurrentSort == "newest")">Mới nhất</option>
                        <option value="price_asc" selected="@(ViewBag.CurrentSort == "price_asc")">Giá tăng dần</option>
                        <option value="price_desc" selected="@(ViewBag.CurrentSort == "price_desc")">Giá giảm dần</option>
                    </select>
                </div>
            </div>

            <!-- Danh sách PC (Dùng lại Class .pcard của ông) -->
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <div class="col">
                            <div class="pcard h-100 d-flex flex-column bg-white border rounded shadow-sm p-3">
                                <span class="badge bg-danger position-absolute top-0 start-0 m-2">-@item.DiscountPercent%</span>
                                <a href="/Home/Details/@item.Id" class="text-decoration-none text-dark flex-grow-1">
                                    <div class="text-center mb-3">
                                        <img src="@item.ImageUrl" alt="@item.Name" class="img-fluid rounded" style="object-fit: cover; aspect-ratio: 1/1;" />
                                    </div>
                                    <h3 class="fs-6 fw-bold mb-2" style="height: 40px; overflow: hidden;">@item.Name</h3>
                                    <div class="d-flex flex-column mb-3">
                                        <span class="fw-bold" style="color: #e6231e; font-size: 16px;">@item.Price.ToString("N0") VNĐ</span>
                                        <span class="text-muted text-decoration-line-through" style="font-size: 12px;">@item.OldPrice.ToString("N0") VNĐ</span>
                                    </div>
                                </a>

                                <div class="d-flex justify-content-between align-items-center mt-auto">

                                    @if (item.StockQuantity > 0)
                                    {
                                        <form asp-controller="Cart"
                                              asp-action="AddToCart"
                                              method="post"
                                              class="m-0 p-0">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <input type="hidden"
                                                   name="quantity"
                                                   value="1" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-primary fw-bold px-2 py-1"
                                                    style="font-size:12px;">

                                                <i class="fa-solid fa-cart-shopping me-1"></i>
                                                THÊM VÀO GIỎ
                                            </button>
                                        </form>

                                        @if (item.StockQuantity <= 5)
                                        {
                                            <span class="product-stock bg-warning bg-opacity-25 text-warning-emphasis">
                                                Còn @item.StockQuantity
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="product-stock bg-success bg-opacity-25 text-success">
                                                Còn hàng
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-secondary fw-bold"
                                                disabled>
                                            <i class="fa-solid fa-ban me-1"></i>
                                            HẾT HÀNG
                                        </button>

                                        <span class="product-stock bg-danger bg-opacity-25 text-danger">
                                            Hết hàng
                                        </span>
                                    }

                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="alert alert-warning text-center py-5">
                            <i class="fa-solid fa-box-open fs-1 text-warning mb-3"></i>
                            <h5 class="fw-bold">Không tìm thấy sản phẩm nào!</h5>
                            <p>Vui lòng thử điều chỉnh lại bộ lọc.</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
