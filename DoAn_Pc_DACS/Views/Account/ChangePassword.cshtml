@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "_AdminLayout";
}

<div class="content-head">
    <div>
        <h1>Đổi mật khẩu bảo mật</h1>
        <div class="breadcrumb-sm">Thay đổi mật khẩu cho tài khoản Admin</div>
    </div>
</div>

<div class="panel" style="max-width: 500px; margin: 0 auto; margin-top: 30px;">
    <div class="panel-head"><h2>Thông tin mật khẩu</h2></div>

    @if (ViewBag.Error != null)
    {
        <div style="padding: 12px; background: var(--a-danger-bg); color: var(--a-danger); border-radius: 8px; margin-bottom: 15px; font-weight: bold;">
            <i class="fa-solid fa-triangle-exclamation"></i> @ViewBag.Error
        </div>
    }
    @if (ViewBag.Success != null)
    {
        <div style="padding: 12px; background: var(--a-success-bg); color: var(--a-success); border-radius: 8px; margin-bottom: 15px; font-weight: bold;">
            <i class="fa-solid fa-check"></i> @ViewBag.Success
        </div>
    }

    <form asp-action="ChangePassword" asp-controller="Account" method="post">
        <div class="form-grid">
            <div class="form-field full">
                <label>Mật khẩu cũ</label>
                <input type="password" name="oldPassword" required />
            </div>
            <div class="form-field full">
                <label>Mật khẩu mới</label>
                <input type="password" name="newPassword" required minlength="3" />
            </div>
            <div class="form-field full">
                <label>Xác nhận mật khẩu mới</label>
                <input type="password" name="confirmPassword" required minlength="3" />
            </div>
            <div class="form-field full" style="margin-top: 10px;">
                <button type="submit" class="btn btn-accent w-100" style="justify-content: center; padding: 12px;">CẬP NHẬT MẬT KHẨU</button>
            </div>
        </div>
    </form>
</div>