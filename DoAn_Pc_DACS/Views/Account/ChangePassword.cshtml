@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "_Layout";
}

<div class="container mt-5 mb-5 d-flex justify-content-center">
    <div class="card shadow-lg border-0" style="width: 500px; border-radius: 12px;">
        <div class="card-header text-center text-white" style="background: #002023; border-radius: 12px 12px 0 0;">
            <h4 class="fw-bold mb-0 py-2"><i class="fa-solid fa-key"></i> ĐỔI MẬT KHẨU</h4>
        </div>
        <div class="card-body p-4 bg-white">

            <!-- Hiện thông báo Lỗi hoặc Thành công -->
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger fw-bold text-center">
                    <i class="fa-solid fa-triangle-exclamation"></i> @ViewBag.Error
                </div>
            }
            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success fw-bold text-center">
                    <i class="fa-solid fa-check-circle"></i> @ViewBag.Success
                </div>
            }

            <form asp-action="ChangePassword" asp-controller="Account" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Mật khẩu cũ</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fa-solid fa-unlock"></i></span>
                        <input type="password" name="oldPassword" class="form-control" placeholder="Nhập mật khẩu cũ..." required />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold text-primary">Mật khẩu mới</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-primary"><i class="fa-solid fa-lock"></i></span>
                        <input type="password" name="newPassword" class="form-control" placeholder="Nhập mật khẩu mới..." required minlength="3" />
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold text-primary">Xác nhận mật khẩu mới</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-primary"><i class="fa-solid fa-check-double"></i></span>
                        <input type="password" name="confirmPassword" class="form-control" placeholder="Nhập lại mật khẩu mới..." required minlength="3" />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-bold py-2 fs-5 mb-2">
                    CẬP NHẬT MẬT KHẨU
                </button>
                <a href="/Admin/Index" class="btn btn-outline-secondary w-100 fw-bold">QUAY LẠI TRANG QUẢN TRỊ</a>
            </form>
        </div>
    </div>
</div>