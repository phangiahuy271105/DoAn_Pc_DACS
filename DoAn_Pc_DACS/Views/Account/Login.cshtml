@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null; // Trang này đứng độc lập, không dùng chung _AdminLayout
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - PGHSHOP Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body class="admin-body">
    <div class="auth-shell">
        <div class="auth-visual">
            <div class="brand">PGH<span>SHOP</span></div>
            <div>
                <h2>Quản lý toàn bộ cửa hàng PC của bạn ở một nơi duy nhất.</h2>
                <p>Đơn hàng, kho, khách hàng, doanh thu — cập nhật theo thời gian thực, không cần mở nhiều công cụ.</p>
            </div>
            <p style="color:#5e7577;">© 2026 PGHSHOP Admin</p>
        </div>

        <div class="auth-form-side">
            <div class="auth-card">
                <h1>Đăng nhập quản trị</h1>
                <div class="sub">Nhập thông tin tài khoản admin để tiếp tục.</div>

                @if (ViewBag.Error != null)
                {
                    <div style="padding: 12px; background: var(--a-danger-bg); color: var(--a-danger); border-radius: 8px; margin-bottom: 20px; font-weight: bold; font-size: 13.5px;">
                        <i class="fa-solid fa-triangle-exclamation"></i> @ViewBag.Error
                    </div>
                }

                <form method="post" asp-controller="Account" asp-action="Login">
                    <div class="form-field">
                        <label>Tên đăng nhập</label>
                        <input type="text" name="username" placeholder="Nhập tài khoản admin..." required />
                    </div>
                    <div class="form-field">
                        <label>Mật khẩu</label>
                        <input type="password" name="password" placeholder="••••••••" required />
                    </div>
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;font-size:12.5px;">
                        <label style="display:flex;align-items:center;gap:6px;color:var(--a-muted);font-weight:400;">
                            <input type="checkbox" style="width:auto;" /> Ghi nhớ đăng nhập
                        </label>
                    </div>
                    <button type="submit" class="btn btn-accent" style="width: 100%; justify-content: center; padding: 12px; font-size: 15px;">Đăng nhập</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>