@model DoAn_Pc_DACS.Models.ProductEditViewModel
@{
    ViewData["Title"] = "Cập nhật sản phẩm";
    Layout = "_AdminLayout";
}

<div class="content-head">
    <div>
        <h1>Cập nhật sản phẩm</h1>
        <div class="breadcrumb-sm">Chỉnh sửa thông tin sản phẩm: @Model.Name</div>
    </div>
    <a href="/Admin/Index" class="btn btn-outline"><i class="fa-solid fa-arrow-left"></i> Quay lại danh sách</a>
</div>

<form asp-action="EditProduct" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ExistingImageUrl" />

    <div class="two-col">
        <!-- CỘT TRÁI: THÔNG TIN -->
        <div class="panel">
            <div class="panel-head"><h2>Thông tin cơ bản</h2></div>
            <div class="form-grid">
                <div class="form-field full">
                    <label>Tên sản phẩm</label>
                    <input asp-for="Name" type="text" required />
                </div>
                <div class="form-field">
                    <label>Danh mục</label>
                    <select asp-for="CategoryId" asp-items="@Model.Categories"></select>
                </div>
                <div class="form-field">
                    <label>Phần trăm giảm (%)</label>
                    <input asp-for="Discount" type="number" />
                </div>
                <div class="form-field">
                    <label>Giá bán (VNĐ)</label>
                    <input asp-for="Price" type="number" required />
                </div>
                <div class="form-field">
                    <label>Giá gốc (VNĐ)</label>
                    <input asp-for="OldPrice" type="number" />
                </div>

                <div class="form-field full">
                    <label>Ảnh đại diện hiện tại</label>
                    @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                    {
                        <img src="@Model.ExistingImageUrl" style="width: 120px; height: 120px; object-fit: cover; border-radius: 8px; border: 1px solid var(--a-border);" />
                    }
                    <label style="margin-top: 10px;">Đổi ảnh đại diện mới (bỏ trống nếu giữ nguyên)</label>
                    <input asp-for="ImageFile" type="file" accept="image/*" class="form-control" style="padding: 6px;" />
                </div>

                <div class="form-field full">
                    <label>Ảnh thư viện (Chọn lại từ đầu nếu muốn cập nhật)</label>
                    <input asp-for="GalleryFiles" type="file" accept="image/*" multiple class="form-control" style="padding: 6px;" />
                    <div style="margin-top: 10px;">
                        <label style="display: flex; align-items: center; gap: 8px; font-weight: normal;">
                            <input asp-for="DeleteOldGallery" type="checkbox" style="width: auto;" /> Xóa tất cả ảnh thư viện cũ khi upload ảnh mới
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: CẤU HÌNH -->
        <div class="panel">
            <div class="panel-head"><h2>Cấu hình chi tiết (Bảng thông số)</h2></div>
            <div class="table-wrap">
                <table class="admin-table">
                    <thead><tr><th>Linh kiện</th><th>Mô tả chi tiết</th><th style="width:60px;">SL</th><th style="width:100px;">Bảo hành</th></tr></thead>
                    <tbody>
                        <tr><td class="cell-title">CPU</td><td><div class="form-field" style="margin:0;"><input asp-for="Socket" type="text" /></div></td><td><div class="form-field" style="margin:0;"><input asp-for="SocketSl" type="number" /></div></td><td><div class="form-field" style="margin:0;"><input asp-for="SocketBh" type="text" /></div></td></tr>
                        <tr><td class="cell-title">Mainboard</td><td><div class="form-field" style="margin:0;"><input asp-for="Mainboard" type="text" /></div></td><td><div class="form-field" style="margin:0;"><input asp-for="MainboardSl" type="number" /></div></td><td><div class="form-field" style="margin:0;"><input asp-for="MainboardBh" type="text" /></div></td></tr>
                        <tr><td class="cell-title">RAM</td><td><div class="form-field" style="margin:0;"><input asp-for="RamType" type="text" /></div></td><td><div class="form-field" style="margin:0;"><input asp-for="RamSl" type="number" /></div></td><td><div class="form-field" style="margin:0;"><input asp-for="RamBh" type="text" /></div></td></tr>
                        <tr><td class="cell-title">Ổ cứng</td><td><div class="form-field" style="margin:0;"><input asp-for="Storage" type="text" /></div></td><td><div class="form-field" style="margin:0;"><input asp-for="StorageSl" type="number" /></div></td><td><div class="form-field" style="margin:0;"><input asp-for="StorageBh" type="text" /></div></td></tr>
                        <tr><td class="cell-title">Nguồn</td><td><div class="form-field" style="margin:0;"><input asp-for="PowerSupply" type="text" /></div></td><td><div class="form-field" style="margin:0;"><input asp-for="PowerSupplySl" type="number" /></div></td><td><div class="form-field" style="margin:0;"><input asp-for="PowerSupplyBh" type="text" /></div></td></tr>
                        <tr><td class="cell-title">VGA</td><td><div class="form-field" style="margin:0;"><input asp-for="Vga" type="text" /></div></td><td><div class="form-field" style="margin:0;"><input asp-for="VgaSl" type="number" /></div></td><td><div class="form-field" style="margin:0;"><input asp-for="VgaBh" type="text" /></div></td></tr>
                        <tr><td class="cell-title">Vỏ Case</td><td><div class="form-field" style="margin:0;"><input asp-for="FormFactor" type="text" /></div></td><td><div class="form-field" style="margin:0;"><input asp-for="FormFactorSl" type="number" /></div></td><td><div class="form-field" style="margin:0;"><input asp-for="FormFactorBh" type="text" /></div></td></tr>
                        <tr><td class="cell-title">Tản nhiệt</td><td><div class="form-field" style="margin:0;"><input asp-for="Cooler" type="text" /></div></td><td><div class="form-field" style="margin:0;"><input asp-for="CoolerSl" type="number" /></div></td><td><div class="form-field" style="margin:0;"><input asp-for="CoolerBh" type="text" /></div></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div style="margin-top: 15px; text-align: right;">
        <button type="submit" class="btn btn-accent" style="padding: 12px 24px; font-size: 16px;">
            <i class="fa-solid fa-floppy-disk"></i> CẬP NHẬT SẢN PHẨM
        </button>
    </div>
</form>