@model DoAn_Pc_DACS.Models.ProductCreateViewModel
@{
    ViewData["Title"] = "Thêm sản phẩm mới";
    Layout = "_AdminLayout";
}

<div class="content-head">
    <div>
        <h1>Thêm sản phẩm mới</h1>
        <div class="breadcrumb-sm">Nhập thông tin chi tiết cho sản phẩm</div>
    </div>
    <a href="/Admin/Index" class="btn btn-outline"><i class="fa-solid fa-arrow-left"></i> Quay lại danh sách</a>
</div>

<form asp-action="CreateProduct" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="two-col">
        <!-- CỘT TRÁI: THÔNG TIN CƠ BẢN -->
        <div class="panel">
            <div class="panel-head"><h2>Thông tin cơ bản</h2></div>
            <div class="form-grid">
                <div class="form-field full">
                    <label>Tên sản phẩm</label>
                    <input asp-for="Name" type="text" placeholder="Nhập tên sản phẩm..." required />
                    <span asp-validation-for="Name" class="text-danger" style="font-size: 12px; color: var(--a-danger);"></span>
                </div>
                <div class="form-field">
                    <label>Danh mục</label>
                    <select asp-for="CategoryId" asp-items="@Model.Categories"></select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label>Phần trăm giảm (%)</label>
                    <input asp-for="Discount" type="number" readonly />
                    <small>Tự tính từ giá gốc và giá bán.</small>
                    <span asp-validation-for="Discount" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label>Giá bán (VNĐ)</label>
                    <input asp-for="Price" type="number" required />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label>Giá gốc (VNĐ)</label>
                    <input asp-for="OldPrice" type="number" />
                    <span asp-validation-for="OldPrice" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label>Số lượng tồn kho</label>
                    <input asp-for="StockQuantity"
                           type="number"
                           min="0"
                           placeholder="Nhập số lượng tồn..." />
                    <span asp-validation-for="StockQuantity"
                          style="font-size:12px; color:var(--a-danger);"></span>
                </div>
                <div class="form-field full">
                    <label>Mô tả sản phẩm</label>
                    <textarea asp-for="Description" rows="4" placeholder="Nhập điểm nổi bật, công dụng hoặc thông tin bảo hành..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="form-field full">
                    <label>Ảnh đại diện (Bắt buộc)</label>
                    <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" required class="form-control" style="padding: 6px;" />
                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>
                <div class="form-field full">
                    <label>Ảnh thư viện (Chọn nhiều ảnh)</label>
                    <input asp-for="GalleryFiles" type="file" accept=".jpg,.jpeg,.png,.webp" multiple class="form-control" style="padding: 6px;" />
                    <span asp-validation-for="GalleryFiles" class="text-danger"></span>
                </div>
                <div class="form-field full" id="relatedProductsPanel">
                    <label>Sản phẩm mua kèm (tối đa 4 danh mục)</label>
                    <select asp-for="RelatedProductIds" asp-items="Model.AvailableRelatedProducts" multiple size="8"></select>
                    <small style="color:var(--a-muted);">Chọn tối đa một món cho mỗi danh mục (màn hình, bàn phím, chuột, tai nghe). Giữ Ctrl để chọn nhiều món.</small>
                    <span asp-validation-for="RelatedProductIds" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="panel" id="buildMetadataPanel" hidden>
            <div class="panel-head"><h2>Phân loại linh kiện cho Build PC</h2></div>
            <div class="form-grid">
                <div class="form-field full">
                    <label asp-for="ComponentType">Loại linh kiện</label>
                    <select asp-for="ComponentType">
                        <option value="">Chưa phân loại</option>
                        <option value="CPU">CPU</option><option value="Mainboard">Mainboard</option>
                        <option value="RAM">RAM</option><option value="GPU">Card đồ họa</option>
                        <option value="Storage">Ổ cứng SSD / HDD</option><option value="PSU">Nguồn</option>
                        <option value="Case">Vỏ case</option><option value="Cooler">Tản nhiệt</option>
                    </select>
                    <span asp-validation-for="ComponentType" class="text-danger"></span>
                </div>
                <div class="form-field full" id="buildSocketField">
                    <label asp-for="BuildSocket">Socket CPU / Mainboard</label>
                    <select asp-for="BuildSocket">
                        <option value="">Chưa xác định / chưa hỗ trợ</option>
                        @foreach (var socket in new[] { "LGA1700", "LGA1851", "LGA1200", "LGA1151", "AM4", "AM5" })
                        {
                            <option value="@socket">@socket</option>
                        }
                    </select>
                    <span asp-validation-for="BuildSocket" class="text-danger"></span>
                </div>
                <div class="form-field full" id="buildMemoryField">
                    <label asp-for="BuildMemoryType">Chuẩn RAM của Mainboard / RAM</label>
                    <select asp-for="BuildMemoryType">
                        <option value="">Chưa xác định / chưa hỗ trợ</option>
                        <option value="DDR3">DDR3</option><option value="DDR4">DDR4</option><option value="DDR5">DDR5</option>
                    </select>
                    <span asp-validation-for="BuildMemoryType" class="text-danger"></span>
                </div>
                <p class="form-field full">Đối chiếu thông số sản phẩm trước khi chọn. Nếu chưa chắc, để “Chưa xác định”; hệ thống không coi dữ liệu thiếu là tương thích.</p>
            </div>
        </div>
        <!-- CỘT PHẢI: CẤU HÌNH CHI TIẾT -->
        <div class="panel" id="pcSpecPanel">
            <div class="panel-head"><h2>Cấu hình bộ PC</h2></div>
            <div class="table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Linh kiện</th>
                            <th>Mô tả chi tiết</th>
                            <th style="width: 60px;">SL</th>
                            <th style="width: 100px;">Bảo hành</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="cell-title">CPU</td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="Socket" type="text" /></div></td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="SocketSl" type="number" /></div></td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="SocketBh" type="text" /></div></td>
                        </tr>
                        <tr>
                            <td class="cell-title">Mainboard</td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="Mainboard" type="text" /></div></td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="MainboardSl" type="number" /></div></td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="MainboardBh" type="text" /></div></td>
                        </tr>
                        <tr>
                            <td class="cell-title">RAM</td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="RamType" type="text" /></div></td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="RamSl" type="number" /></div></td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="RamBh" type="text" /></div></td>
                        </tr>
                        <tr>
                            <td class="cell-title">Ổ cứng</td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="Storage" type="text" /></div></td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="StorageSl" type="number" /></div></td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="StorageBh" type="text" /></div></td>
                        </tr>
                        <tr>
                            <td class="cell-title">Nguồn</td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="PowerSupply" type="text" /></div></td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="PowerSupplySl" type="number" /></div></td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="PowerSupplyBh" type="text" /></div></td>
                        </tr>
                        <tr>
                            <td class="cell-title">Card Màn Hình</td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="Vga" type="text" /></div></td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="VgaSl" type="number" /></div></td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="VgaBh" type="text" /></div></td>
                        </tr>
                        <tr>
                            <td class="cell-title">Vỏ Case</td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="FormFactor" type="text" /></div></td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="FormFactorSl" type="number" /></div></td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="FormFactorBh" type="text" /></div></td>
                        </tr>
                        <tr>
                            <td class="cell-title">Tản nhiệt</td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="Cooler" type="text" /></div></td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="CoolerSl" type="number" /></div></td>
                            <td><div class="form-field" style="margin:0;"><input asp-for="CoolerBh" type="text" /></div></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="panel" id="accessorySpecPanel" hidden>
            <div class="panel-head"><h2>Thông số kỹ thuật sản phẩm</h2></div>
            <div class="form-field" style="padding:20px;">
                <label>Nhập mỗi thông số trên một dòng</label>
                <textarea asp-for="TechnicalSpecifications" rows="20" placeholder="Ví dụ màn hình:&#10;Kích thước: 27 inch&#10;Độ phân giải: 2560 x 1440&#10;Tần số quét: 180Hz&#10;Tấm nền: IPS&#10;&#10;Ví dụ chuột:&#10;Cảm biến: HERO 25K&#10;DPI: 25600&#10;Kết nối: Không dây"></textarea>
                <small style="color:var(--a-muted);">Định dạng: Tên thông số: Giá trị.</small>
                <span asp-validation-for="TechnicalSpecifications" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div style="margin-top: 15px; text-align: right;">
        <button type="submit" class="btn btn-accent" style="padding: 12px 24px; font-size: 16px;">
            <i class="fa-solid fa-floppy-disk"></i> LƯU SẢN PHẨM MỚI
        </button>
    </div>
</form>

@section Scripts {
    <script src="~/js/admin-build-metadata.js" asp-append-version="true"></script>
    <script src="~/js/admin-product-price.js" asp-append-version="true"></script>
    <script>
        (() => {
            const category = document.getElementById('CategoryId');
            const pcPanel = document.getElementById('pcSpecPanel');
            const accessoryPanel = document.getElementById('accessorySpecPanel');
            const relatedPanel = document.getElementById('relatedProductsPanel');
            const updatePanels = () => {
                const text = category.options[category.selectedIndex]?.text?.toUpperCase() || '';
                const isPc = text.includes('PC GAMING') || text.includes('PC WORKSTATION');
                pcPanel.hidden = !isPc;
                accessoryPanel.hidden = isPc;
                relatedPanel.hidden = !isPc;
                relatedPanel.querySelectorAll('select').forEach(input => input.disabled = !isPc);
            };
            category.addEventListener('change', updatePanels);
            updatePanels();
        })();
    </script>
}
