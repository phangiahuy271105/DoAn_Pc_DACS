@model IEnumerable<DoAn_Pc_DACS.Models.Product>

@{
    ViewData["Title"] = "Quản lý Sản phẩm";
    ViewData["Active"] = "products";
    Layout = "_AdminLayout";
}

<div class="content-head">
    <div>
        <h1>Sản phẩm</h1>
        <div class="breadcrumb-sm">Danh sách các sản phẩm đang bán trên PGHSHOP</div>
    </div>
    <!-- Nút bấm gọi Action CreateProduct thật của anh em mình -->
    <a href="/Admin/CreateProduct" class="btn btn-accent">
        <i class="fa-solid fa-plus"></i> Thêm sản phẩm
    </a>
</div>

<div class="panel">
    <div class="table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Hình ảnh</th>
                    <th>Tên Sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Giá bán</th>
                    <th>Giá gốc</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                <!-- LÒNG GHÉP CODE C# LẤY DATABASE Ở ĐÂY -->
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <div class="cell-thumb">
                                <img src="@p.ImageUrl" alt="@p.Name" style="width: 40px; height: 40px; object-fit: cover; border-radius: 6px;" />
                            </div>
                        </td>
                        <td>
                            <div class="cell-title">@p.Name</div>
                            <div class="cell-sub">ID: #@p.Id</div>
                        </td>
                        <td><span class="pill pill-info">@(p.Category?.Name ?? "Chưa có")</span></td>
                        <td class="cell-title" style="color: var(--a-danger);">@p.Price.ToString("N0")₫</td>
                        <td style="text-decoration: line-through; color: var(--a-muted);">@p.OldPrice.ToString("N0")₫</td>

                        <td>
                            <div class="row-actions">
                                <!-- Nút Sửa gọi Action thật -->
                                <a href="/Admin/EditProduct/@p.Id" class="btn btn-outline btn-icon" title="Sửa">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <!-- Nút Xóa gọi Action thật -->
                                <form action="/Admin/DeleteProduct" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xoá sản phẩm này?');" style="display:inline;">
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <button type="submit" class="btn btn-outline btn-icon" title="Xoá" style="color:var(--a-danger);">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>